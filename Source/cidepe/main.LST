.................... #include <18F4620.h> 
.................... //////// Standard Header file for the PIC18F4620 device //////////////// 
.................... #device PIC18F4620 
.................... #list 
....................  
....................  
.................... #use delay(clock=20000000) 
....................  
.................... //#fuses HS 
....................  
.................... #FUSES NOWDT                    //No Watch Dog Timer 
.................... #FUSES HS                       //20MHz 
.................... #FUSES NOPUT                    //No Power Up Timer 
....................                   //Code protected from reads 
....................  
.................... #FUSES NOWRT, NODEBUG 
.................... #FUSES PROTECT, NOLVP 
.................... #FUSES CPB, CPD	//Colocado para protecao do codigo 
.................... 				//Fabio Bairros - 21/01/2010 
....................  
.................... int Func=0;		//Definida a variavel neste momento 
.................... 				//Fabio Bairros - 22/01/2014 
....................  
.................... #include "lcd.h" 
.................... /////////////////////////////////////////////////////////////////////////// 
.................... ////                             LCD.H                                 //// 
.................... ////                 Driver para modulo LCD ITM1602                    //// 
.................... ////         Define funções para inicializar, movimentar,              //// 
.................... ////                escrever e ler caracteres.						   ////	 
.................... ///////////////////////////////////////////////////////////////////////////   
.................... /* 
.................... ************* Pinagem**************** 
....................       PIC  LCD 
.................... //     D0  enable 
.................... //     D1  rs 
.................... //     D2  rw 
.................... //     D4  D4 
.................... //     D5  D5 
.................... //     D6  D6 
.................... //     D7  D7 
.................... // 
.................... //   LCD pins D0-D3 are not used and PIC D3 is not used. 
....................  
....................  
.................... ************* instruções de baixo nível ********************* 
....................  
.................... BYTE lcd_read_byte()  
....................  
.................... void lcd_send_nibble( BYTE n )  
....................  
.................... void lcd_send_byte( BYTE address, BYTE n ) 
....................  
....................  
....................  
....................  
.................... ************* Funções de alto nível **************** 
....................  
.................... void lcd_init()   	deve ser chamada antes de qualquer outra função.. uma unica vez 
....................  
.................... void lcd_escreve(c)  	escreve no display o caracter ou string 
.................... 				       utilizada para envio de uma linha de mensagens ao display 
....................  
.................... void lcd_escreve_digito(i)  	escreve no display o caracter do numero inteiro 
.................... 				       		utilizado para atualizar o tempo cronometrado, digito por digito 
....................  
.................... void lcd_posicaoxy(x,y) define a posição de escrita  (x coluna, y linha) 
.................... 					   lcd_pocisaoxy(1,1)     movimenta para o canto superior esquerdo 
....................  
.................... char lcd_getc(x,y)   lê do display o caracter na posição definida em x,y  
....................  
.................... void lcd_limpa() 	 limpa LCD 
....................  
.................... void lcd_linha2()	 posiciona na linha 2           
....................  
.................... void lcd_linha1()	 posiciona na linha 1           
....................  
....................  
.................... //outras funcoes utilizadas.... 
.................... delay_cycles(x)        clock 20MHz -> 4*1/20M= 0.0000002 -> 5ciclos/us 
....................  
.................... */ 
....................  
....................  
