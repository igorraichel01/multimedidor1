.................... #include "kbd2.h" 
.................... /////////////////////////////////////////////////////////////////////////// 
.................... ////                             KBD2.h                                //// 
.................... ////                 Driver para modulo teclado 16 teclas (4x4)        //// 
.................... ////         Define funções para identificar tecla pressionada e 	   //// 
.................... ////                configurações do teclado.						   ////	 
.................... ///////////////////////////////////////////////////////////////////////////   
.................... /* 
.................... ************* Pinagem**************** 
....................       PIC  teclado 
.................... //     RC0	C0 
.................... //     RC1	C1 
.................... //     RC2	C2 
.................... //     RC3	C3  	 
.................... //     RC4	L0 
.................... //     RC5	L1 
.................... //     RC6  L2 
.................... //	   RC7	L3	 
....................  
.................... //   C0-C3 sao utilizados como coluna da matriz 
.................... //	e sao ativados por software para detectar qual linha foi pressionada 
.................... //   L0-L3 sao utilizados como linhas da matriz 
.................... //	e por serem configurados como entrada, serao ativados quando pressionada 
.................... //	alguma tecla 
....................  
....................  
.................... *****************    ATENCAO !   ******************** 
.................... *  utiliza TIMER0 para gerar a varredura do teclado * 
.................... ***************************************************** 
....................  
....................  
.................... ************* instruções de baixo nível ********************* 
....................  
.................... char kbd_getc( ) 		utilizada para identificar a tecla na matriz 
.................... 					a matriz constante KEYS define as teclas 
....................  
....................  
.................... void kbd_init()			configura o teclado e inicializa 
....................  
....................  
.................... ************* Funções de alto nível **************** 
....................  
.................... void kbd_habilita()		habilita a interrupcao que le o teclado 
....................  
.................... void kbd_desabilita()	desabilita a interrupcao que le o teclado 
....................  
....................  
....................          
....................  
....................  
.................... */ 
.................... // Keypad layout: 
.................... char const KEYS[4][4] = {{'1','2','3','A'}, 
....................                          {'4','5','6','B'}, 
....................                          {'7','8','9','C'}, 
....................                          {'*','0','#','D'}}; 
....................  
....................  
.................... #define KBD_DEBOUNCE_FACTOR 25 		//  para validar a tecla pressionada 
.................... #define TEMPO_TECLA_REPETIDA 400		// 1 segundo para tecla repetida (400) 
....................  
.................... int16 temp_debounce=KBD_DEBOUNCE_FACTOR; 
.................... char temp_tecla_anterior; 
.................... int flagTeclado=0; 
.................... int16 flagEstado=0; 
.................... char tecla_valida;			// armazena tecla valida... apos debounce 
.................... int  passag=0; 
.................... int  passag2=0; 
.................... //int Func=0; 
....................  
.................... int numInt=1;							// numero intervalos 1->10 
....................  
.................... /* 
....................  
....................     ---------------------------             ^ 
....................    |                           |            | (4)    
....................    |                           |  (5) <-          -> (6) 
....................    |                           |            | 
....................     ---------------------------             v (A) 
....................       ----      ----       ---- 
....................       L_FUNC    M_FUNC    R_FUNC   
....................         (1)       (2)       (3)              
....................         
....................  
.................... */ 
....................  
.................... #define L_FUNC 	'1' 
.................... #define M_FUNC 	'2' 
.................... #define R_FUNC 	'3' 
.................... #define DESCE	'A'  
.................... #define SOBE	'4'  
.................... #define DIR		'6'  
.................... #define ESQ		'5' 
.................... #define RESET	'B'  
....................  
.................... #define use_portc_kbd TRUE 
.................... #byte kbd = 0xF82 
....................  
.................... #define set_tris_kbd(x) set_tris_c(x) 
....................  
....................  
.................... #define COL0 (1 << 0) 
.................... #define COL1 (1 << 1) 
.................... #define COL2 (1 << 2) 
.................... #define COL3 (1 << 3) 
....................  
.................... #define LINHAS	 0xF0 
.................... #define ALL_PINS 0xFF 
....................  
....................  
....................  
.................... void kbd_init(){ 
.................... 	setup_timer_0 (RTCC_INTERNAL|RTCC_DIV_64 | RTCC_8_BIT); // clock interno, pre-escala 64x,  
.................... 	set_timer0(100); 
.................... 	enable_interrupts(INT_RTCC);									//  
....................     //enable_interrupts(GLOBAL); 
.................... 	 
.................... } 
....................  
.................... void kbd_habilita() { 
.................... 	set_timer0(100); 
.................... 	enable_interrupts(INT_RTCC);									//  
....................     //enable_interrupts(GLOBAL); 
.................... } 
....................  
.................... void kbd_desabilita() { 
.................... 	disable_interrupts(INT_RTCC);									//  
.................... } 
....................  
.................... char kbd_getc( ) { 
....................     
....................  
....................    BYTE kchar; 
....................    
....................  
.................... /// teste coluna 0 
.................... 	set_tris_kbd(LINHAS); 		// coloca como entrada as linhas e saídas as colunas 
*
02736:  MOVLW  F0
02738:  MOVWF  F94
.................... 	delay_us(1); 
0273A:  BRA    273C
0273C:  BRA    273E
0273E:  BRA    2740
....................     kbd=COL0;					// ativa coluna0 
