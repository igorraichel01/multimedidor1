02742:  MOVWF  F82
.................... 	delay_us(1); 
02744:  BRA    2746
02746:  BRA    2748
02748:  BRA    274A
.................... 	kchar=kbd; 
0274A:  MOVFF  F82,17F
.................... 	set_tris_kbd(ALL_PINS); 
0274E:  MOVLW  FF
02750:  MOVWF  F94
.................... 	if(kchar==0x11) 
