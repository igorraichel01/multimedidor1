.................... 		return(KEYS[2][0]);		//return('7'); 
02772:  MOVLW  37
02774:  MOVWF  01
02776:  BRA    286C
.................... 	if(kchar==0x81) 
02778:  MOVF   x7F,W
0277A:  SUBLW  81
0277C:  BNZ   2784
.................... 		return(KEYS[3][0]);		//return('*'); 
0277E:  MOVLW  2A
02780:  MOVWF  01
02782:  BRA    286C
....................  
.................... /// testa coluna 1 
.................... 	set_tris_kbd(LINHAS); 
02784:  MOVLW  F0
02786:  MOVWF  F94
.................... 	delay_us(1); 
02788:  BRA    278A
0278A:  BRA    278C
0278C:  BRA    278E
.................... 	kbd=COL1;					// ativa coluna1 
0278E:  MOVLW  02
02790:  MOVWF  F82
.................... 	delay_us(1); 
02792:  BRA    2794
02794:  BRA    2796
02796:  BRA    2798
....................     kchar=kbd; 
02798:  MOVFF  F82,17F
.................... 	set_tris_kbd(ALL_PINS); 
0279C:  MOVLW  FF
0279E:  MOVWF  F94
.................... 	if(kchar==0x12) 
027A0:  MOVF   x7F,W
027A2:  SUBLW  12
