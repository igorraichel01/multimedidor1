void lcd_escreve_Dist(long dist){
	
	long k, c,d,u;
	long  dist_c;
	long dist_d, dist_u;

	k=(dist/1000);
	dist_c=dist-(1000*k);
	c=(dist_c/100);
	dist_d=dist_c-(100*c);
	d=(dist_d/10);
	dist_u=dist_d-(10*d);
	u=dist_u;

	lcd_posicaoxy(5,2);
	lcd_escreve_digito((int)k);
	lcd_escreve_digito((int)c);
	lcd_escreve_digito((int)d);
	lcd_escreve_digito((int)u);

