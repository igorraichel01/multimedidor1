///////////////////////////////////////////////////////////////////////////
////                             LCD.H                                 ////
////                 Driver para modulo LCD ITM1602                    ////
////         Define funções para inicializar, movimentar,              ////
////                escrever e ler caracteres.						   ////	
///////////////////////////////////////////////////////////////////////////  
/*
************* Pinagem****************
      PIC  LCD
//     D0  enable
//     D1  rs
//     D2  rw
//     D4  D4
//     D5  D5
//     D6  D6
//     D7  D7
//
//   LCD pins D0-D3 are not used and PIC D3 is not used.


************* instruções de baixo nível *********************

BYTE lcd_read_byte() 

void lcd_send_nibble( BYTE n ) 

void lcd_send_byte( BYTE address, BYTE n )




************* Funções de alto nível ****************

void lcd_init()   	deve ser chamada antes de qualquer outra função.. uma unica vez

void lcd_escreve(c)  	escreve no display o caracter ou string
				       utilizada para envio de uma linha de mensagens ao display

void lcd_escreve_digito(i)  	escreve no display o caracter do numero inteiro
				       		utilizado para atualizar o tempo cronometrado, digito por digito

void lcd_posicaoxy(x,y) define a posição de escrita  (x coluna, y linha)
					   lcd_pocisaoxy(1,1)     movimenta para o canto superior esquerdo

char lcd_getc(x,y)   lê do display o caracter na posição definida em x,y 

void lcd_limpa() 	 limpa LCD

void lcd_linha2()	 posiciona na linha 2          

void lcd_linha1()	 posiciona na linha 1          


//outras funcoes utilizadas....
delay_cycles(x)        clock 20MHz -> 4*1/20M= 0.0000002 -> 5ciclos/us

*/


#use delay(clock=24000000)

// Caso LCD na porta B
// #define use_portb_lcd TRUE

struct lcd_pin_map {                 // This structure is overlayed
           BOOLEAN enable;           // on to an I/O port to gain
           BOOLEAN rs;               // access to the LCD pins.
           BOOLEAN rw;               // The bits are allocated from
           BOOLEAN unused;           // low order up.  ENABLE will
           int     data : 4;         // be pin B0.
        } lcd;

#locate lcd = 0xf83
#define set_tris_lcd(x) set_tris_d(x)


#define lcd_type 2           // 0=5x7, 1=5x10, 2=2 lines
#define lcd_line_two 0x40    // LCD RAM address for the second line


BYTE const LCD_INIT_STRING[4] = {0x20 | (lcd_type << 2), 0xc, 1, 6};
                             // These bytes need to be sent to the LCD
                             // to start it up.
						//  [1] 0xc -> 1 1 0 0
							 //        | | |  |-> blink off
							 //        | | |-> cursor off
							 //        | |-> display on
							 //        |-> sempre 1
						//   [2] 1 -> display clear
						//   [3] 6 -> 1 1 0
							 //       | | |-> desloca p/ direita
							 //       | |-> incrementa uma posição 
							 // 	  |->sempre 1
                             // The following are used for setting
                             // the I/O port direction register.


struct lcd_pin_map const LCD_WRITE = {0,0,0,0,0}; // For write mode all pins are out
struct lcd_pin_map const LCD_READ = {0,0,0,0,15}; // For read mode data pins are in

void nop(){

	#asm
		NOP
		NOP
	#endasm
}

///////////////////// instruções de baixo nível
BYTE lcd_read_byte() 
{
      BYTE low,high;
      set_tris_lcd(LCD_READ);
      lcd.rw = 1;
	  nop();
	  //delay_cycles(1);
      lcd.enable = 1;
      nop();
	  //delay_cycles(1);
      high = lcd.data;
      lcd.enable = 0;
      nop();
	  //delay_cycles(1);
      lcd.enable = 1;
      nop();
	  //delay_cycles(1);
      low = lcd.data;
      lcd.enable = 0;
      set_tris_lcd(LCD_WRITE);
      return( (high<<4) | low);
}

void lcd_send_nibble( BYTE n ) 
{
      lcd.data = n;
      nop();
	  //delay_cycles(1);
      lcd.enable = 1;
      nop();
	  //delay_cycles(1);
      lcd.enable = 0;
}

void lcd_send_byte( BYTE address, BYTE n )
 {

      lcd.rs = 0;
      //****** para Debug ****** comente a linha abaixo
	  while ( bit_test(lcd_read_byte(),7) ) ;
      lcd.rs = address;
      nop();
	  //delay_cycles(1);
      lcd.rw = 0;
      nop();
	  //delay_cycles(1);
      lcd.enable = 0;
      lcd_send_nibble(n >> 4);
      lcd_send_nibble(n & 0xf);
}



/////////////////////////////FUNÇÕES//////////////////////////////


////////////// inicializa LCD //////////////////////////
void lcd_init()
 {
    BYTE i;
    set_tris_lcd(LCD_WRITE);
    lcd.rs = 0;
    lcd.rw = 0;
    lcd.enable = 0;
    delay_us(15);
    for(i=1;i<=3;++i) {
       lcd_send_nibble(3);
       delay_us(15);
    }
    lcd_send_nibble(2);
    for(i=0;i<=3;++i)
       lcd_send_byte(0,LCD_INIT_STRING[i]);
}


/////////////// posiciona cursor //////////////////////
void lcd_posicaoxy( BYTE x, BYTE y)
 {
   BYTE address;

   if(y!=1)
     address=lcd_line_two;
   else
     address=0;
   address+=x-1;
   lcd_send_byte(0,0x80|address);
}


char lcd_getc( BYTE x, BYTE y) 
{
   char value;

    lcd_posicaoxy(x,y);
    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low
    lcd.rs=1;
    value = lcd_read_byte();
    lcd.rs=0;
    return(value);
}

int lcd_getdigito( BYTE x, BYTE y) 
{
   char value;
	int digito;

    lcd_posicaoxy(x,y);
    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low
    lcd.rs=1;
    value = lcd_read_byte();
    lcd.rs=0;

	switch (value) {

	    case '0':
			digito=0;
			break;
	
	    case '1':
			digito=1;
			break;

	    case '2':
			digito=2;
			break;

	    case '3':
			digito=3;
			break;
	    case '4':
			digito=4;
			break;
	    case '5':
			digito=5;
			break;
	    case '6':
			digito=6;
			break;
	    case '7':
			digito=7;
			break;
	    case '8':
			digito=8;
			break;
	    case '9':
			digito=9;
			break;
		default:digito=0;

	}

    return(digito);
}
/////////// esreve uma linha //////////////////
void lcd_escreve( char c) 
{
   lcd_send_byte(1,c);
}

///////////limpa LCD///////////////////
void lcd_limpa()           
{
   lcd_send_byte(0,1);
    
}

/////////// posiciona na linha 2///////////////////
void lcd_linha2()          
{
   lcd_posicaoxy(1,2);
}

/////////// posiciona na linha 1///////////////////
void lcd_linha1()          
{
   lcd_posicaoxy(1,1);
}

/////////// escreve um dígito de tempo ///////////////////
void lcd_escreve_digito(int digito)          
{

	switch (digito) {

	    case 0:
			lcd_escreve('0');
			break;
	
	    case 1:
			lcd_escreve('1');
			break;
	
	    case 2:
			lcd_escreve('2');
			break;
	
	    case 3:
			lcd_escreve('3');
			break;
	
	    case 4:
			lcd_escreve('4');
			break;
	
	    case 5:
			lcd_escreve('5');
			break;
	
	    case 6:
			lcd_escreve('6');
			break;
	
	    case 7:
			lcd_escreve('7');
			break;
	
	    case 8:
			lcd_escreve('8');
			break;
	
	    case 9:
			lcd_escreve('9');
			break;
	}

}

long lcd_getDistancia()
{

	long k, c, d, u;
	long dist;

	k=lcd_getdigito( 5, 2);
	c=lcd_getdigito( 6, 2);
	d=lcd_getdigito( 7, 2);
	u=lcd_getdigito( 8, 2);
	

	dist=(long)(k*1000);
	dist=dist+(long)(c*100);
	dist=dist+(long)(d*10);
	dist=dist+(long)u;
	return(dist);
}

