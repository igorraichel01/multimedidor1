long lcd_getInt(){

	long d, u;
	long Interv;
	
	d=lcd_getdigito( 7, 2);
	u=lcd_getdigito( 8, 2);
	
	Interv=(long)(d*10);
	Interv=Interv+(long)u;
	return(Interv);
}
void lcd_escreve_Int(long interv){ 		//valores entre 1-> 99
	
	long d, u;

	lcd_posicaoxy(7,2);
	d=(interv/10);
	u=interv-(10*d);
	lcd_escreve_digito((int)d);
	lcd_escreve_digito((int)u);

}
